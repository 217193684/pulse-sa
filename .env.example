# Postgres connection string (Neon gives you this; keep it secret)
DATABASE_URL=
# Long random string; GitHub Actions and Vercel Cron send it to /api/cron/collect
CRON_SECRET=
# Long random string for adding feed videos via /api/admin/videos
ADMIN_TOKEN=
# Optional: the public address of this server, used in share captions
APP_URL=
# Optional: override news feeds, "Name|https://feed,Name|https://feed"
NEWS_FEEDS=
